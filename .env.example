# Copia este fichero a .env y rellena los valores. .env esta gitignored (no se sube).

# --- RunPod (obligatorio para lanzar pods) ---
RUNPOD_API_KEY=

# --- Repo que clonara el pod (debe estar pusheado a GitHub con estos cambios) ---
REPO_URL=https://github.com/DanielArizaGarcia/Hybrid-PI-DDPM.git
REPO_BRANCH=main

# --- Dataset: elige UNA opcion ---
# Opcion A (recomendada): id de Google Drive del processed_image2.zip (compartido "cualquiera con enlace")
DRIVE_FILE_ID=
# Opcion B: URL directa de descarga del zip (S3, HuggingFace, etc.)
DATASET_URL=
# Opcion C: subir el zip a mano al pod en /workspace/Datos/processed_image2.zip (dejar A y B vacios)

# --- Opcionales de RunPod (tienen defaults razonables en launch.py) ---
# RUNPOD_GPU=NVIDIA GeForce RTX 4090
# RUNPOD_IMAGE=runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
# RUNPOD_VOLUME_GB=60
# RUNPOD_DISK_GB=30
# SMOKE=0
